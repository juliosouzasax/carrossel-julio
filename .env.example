# Copie este arquivo para .env.local (local) e cadastre as mesmas variáveis na Vercel (Settings > Environment Variables).
# NUNCA coloque valores reais neste arquivo nem faça commit de .env.local.

# --- OpenAI (pesquisa, roteiro, imagens e revisão) ---
OPENAI_API_KEY=
# Opcional: só se usar um endpoint compatível/proxy
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Supabase (banco + armazenamento das imagens) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket PÚBLICO onde ficam os slides em JPEG (a Meta precisa baixar as imagens por URL)
SUPABASE_BUCKET=carrosseis

# --- Segurança do painel e do agendador ---
# Senha para entrar no painel
PANEL_PASSWORD=
# Texto longo e aleatório (32+ caracteres) para assinar o cookie de sessão
SESSION_SECRET=
# Segredo que a Vercel envia no cabeçalho Authorization do cron (Bearer). Cadastre com o nome exato CRON_SECRET.
CRON_SECRET=
# 32 bytes em base64 para cifrar o token do Instagram no banco. Gere com: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Instagram (API com Login do Instagram, host graph.instagram.com) ---
# Token de longa duração da conta @juliosouza_costa, gerado no painel do app da Meta
# com a permissão instagram_business_content_publish. Só serve de semente: depois fica cifrado no banco e é renovado sozinho.
IG_ACCESS_TOKEN=
# Versão da Graph API (a documentação da Meta usava v27.0 em 09/11/2026)
IG_GRAPH_VERSION=v27.0
IG_CONTA=juliosouza_costa
